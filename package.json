{
  "name": "conversor-grafix",
  "version": "0.1.0",
  "private": true,
  "description": "Conversor da Grafix: ferramentas de PDF e imagem que rodam 100% no navegador.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "preact": "11.1.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.8"
  }
}
